# LOCAL development database (docker compose up -d). The DigitalOcean URL goes in a separate .env.do - see guide C0.
DATABASE_URL="postgresql://karkaii:karkaii_dev@localhost:5432/karkaii?schema=public"

# Prisma's datasource also needs DIRECT_URL (prisma/schema.prisma sets directUrl = env("DIRECT_URL")).
# Locally there's no connection pooler, so it's just the same value as DATABASE_URL.
# Against Supabase: DATABASE_URL = the pooled connection (port 6543, ?pgbouncer=true) used by the running app;
# DIRECT_URL = the session-pooler/direct connection (port 5432, no pgbouncer) used only by `prisma migrate`.
# Percent-encode any special character in the password (e.g. a literal @ becomes %40) or the URL won't parse.
DIRECT_URL="postgresql://karkaii:karkaii_dev@localhost:5432/karkaii?schema=public"

# Generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=paste-the-64-character-secret-here.

# access token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30


# sign-up / sign-in attempts allowed per minute per IP
AUTH_RATE_LIMIT=10

# false for plain-http local development; true in production over HTTPS
COOKIE_SECURE=false

# your frontend dev proxy already forwards /api to port 5000
PORT=5000

# API documentation (Swagger UI) at http://localhost:5000/api/docs
# On by default, and OFF when NODE_ENV=production (the server). Uncomment to force it either way.
# DOCS_ENABLED=true
