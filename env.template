# LOCAL development database (docker compose up -d). The DigitalOcean URL goes in a separate .env.do - see guide C0.
DATABASE_URL="postgresql://karkaii:karkaii_dev@localhost:5432/karkaii?schema=public"

# Generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=paste-the-64-character-secret-here

# access token lifetime in seconds (900 = 15 minutes)
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30

# sign-up / sign-in attempts allowed per minute per IP
AUTH_RATE_LIMIT=10

# false for plain-http local development; true in production over HTTPS
COOKIE_SECURE=false

# your frontend dev proxy already forwards /api to port 5000
PORT=5000
